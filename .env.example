# Server Configuration
NODE_ENV=development
PORT=5000

# Authentication (Required for user sessions and JWT tokens)
JWT_SECRET=dev_jwt_secret_key_change_in_production_32chars

# Database Configuration
# MongoDB is used for persistent storage. If MongoDB is unavailable locally,
# the system gracefully operates using high-performance in-memory storage for demonstration.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cti_aggregator

# AI Threat Analysis (Optional for core dashboard, required for AI Chat Assistant)
OPENAI_API_KEY=

# Cyber Threat Intelligence API Keys (Optional - public feeds work without keys)
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSECH_AUTH_KEY=
